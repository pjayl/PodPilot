{
  "name": "Python Claude Agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "developer",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude/devpod-oauth-token,target=/run/claude-master/oauth-token,type=bind,readonly"
  ],
  "postStartCommand": ["bash", "/usr/local/bin/init-claude-auth.sh"]
}
